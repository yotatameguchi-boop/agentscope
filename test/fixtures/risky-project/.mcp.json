{
  "mcpServers": {
    "local-files": {
      "command": "npx",
      "args": ["-y", "@example/files-server"],
      "env": { "FILES_ROOT": "/tmp" }
    },
    "remote-api": {
      "type": "http",
      "url": "https://mcp.example.com/v1",
      "headers": { "Authorization": "Bearer ${EXAMPLE_TOKEN}" }
    }
  }
}
